# ─── Auth (Better Auth) ─────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Neon Serverless Postgres (POOLED connection string, ep-…-pooler) ─
DATABASE_URL=

# ─── Neon Object Storage (S3-compatible, from Neon console) ──────────
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET_NAME=synthetix-recordings
NEON_STORAGE_REGION=us-east-2

# ─── LiveKit Cloud ───────────────────────────────────────────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# public URL only — never a key
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ─── Groq (server-only: STT proxy /api/stt/transcribe) ───────────────
GROQ_API_KEY=

# ─── Upstash Redis (rate limiting P0, retry queue P1) ────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Optional (P1: GitHub OAuth login) ───────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
